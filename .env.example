# PostgreSQL (hosted: Neon / Supabase / RDS / Railway)
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Auth.js (NextAuth v5) — locked for MVP (not Clerk)
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional mailbox login (IMAPS 993 / POP3S 995). Tenant settings can override.
MAIL_AUTH_IMAP_HOST=
MAIL_AUTH_IMAP_PORT=993
MAIL_AUTH_POP3_HOST=
MAIL_AUTH_POP3_PORT=995
# Dev-only: skip TLS cert verification for mail auth
MAIL_AUTH_TLS_INSECURE=false

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Transactional email (invites). A Resend send-only key is enough.
# AUTH_URL must be the public origin used in invite links.
RESEND_API_KEY=
RESEND_FROM=Nine CRM <no-reply@nine-security.com>

# Optional: Cloudflare zone for the sending domain (Zone.DNS Edit to write records).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Seed is for local / staging only. Never run against production.
SEED_ENABLED=true
